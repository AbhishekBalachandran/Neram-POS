# Application Environment Configuration
# Copy this file to .env or .env.production and fill in appropriate values

# API Configuration
API_BASE_URL=https://api.nerampos.example.com/v1
API_TIMEOUT_SECONDS=30

# App Metadata
APP_ENVIRONMENT=development
APP_NAME=NERAM POS - Restaurant & Cafe Management System

# Security / Token Settings
SECURE_STORAGE_KEY_PREFIX=neram_pos_
ACCESS_TOKEN_KEY=access_token
REFRESH_TOKEN_KEY=refresh_token
ENABLE_DEVICE_ENCRYPTION=true

